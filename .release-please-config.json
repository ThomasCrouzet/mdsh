{
	"release-type": "node",
	"include-component-in-tag": false,
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": false,
	"draft": false,
	"prerelease": false,
	"pull-request-header": "Mise à jour de la version et du journal des modifications.",
	"pull-request-footer": "Validation requise: typage, lint, tests et builds.",
	"packages": {
		".": {
			"release-type": "node",
			"package-name": "mdsh",
			"changelog-path": "CHANGELOG.md"
		}
	},
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
