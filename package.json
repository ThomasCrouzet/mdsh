{
	"name": "mdsh",
	"private": true,
	"version": "1.5.0",
	"description": "A local-first WYSIWYG markdown editor - offline, 100% client-side PWA. No server, no account, no telemetry.",
	"license": "MIT",
	"author": "Thomas Crouzet",
	"homepage": "https://thomascrouzet.github.io/mdsh/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ThomasCrouzet/mdsh.git"
	},
	"bugs": {
		"url": "https://github.com/ThomasCrouzet/mdsh/issues"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"pwa",
		"offline",
		"svelte",
		"sveltekit",
		"milkdown",
		"client-side",
		"note-taking"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:pages": "node scripts/preview-pages.mjs",
		"prepare": "node scripts/prepare.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:katex-assets",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:katex-assets": "node scripts/sync-katex-assets.mjs --check",
		"notices:generate": "node scripts/generate-third-party-notices.mjs",
		"notices:check": "node scripts/generate-third-party-notices.mjs --check",
		"sbom:npm": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom-npm.cdx.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"size": "size-limit && node scripts/bundle-graph.mjs",
		"sync:katex-assets": "node scripts/sync-katex-assets.mjs",
		"analyze": "npx vite-bundle-visualizer",
		"clean": "rm -rf build .svelte-kit node_modules/.vite test-results playwright-report src-tauri/target",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@size-limit/file": "13.0.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tauri-apps/cli": "2.11.4",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.6",
		"@types/js-yaml": "4.0.9",
		"@types/node": "26.4.0",
		"@vite-pwa/assets-generator": "1.0.2",
		"@vite-pwa/sveltekit": "1.1.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.0.0",
		"fast-check": "4.9.0",
		"globals": "^17.11.0",
		"jsdom": "^26.0.0",
		"lefthook": "2.1.12",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "13.0.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.2",
		"@codemirror/view": "^6.43.10",
		"@lucide/svelte": "1.38.0",
		"@milkdown/crepe": "^7.22.1",
		"@milkdown/kit": "^7.21.3",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-dialog": "2.7.3",
		"dexie": "^4.4.5",
		"dompurify": "~3.4.14",
		"highlight.js": "~11.12.0",
		"js-yaml": "~4.3.2",
		"jszip": "~3.10.1",
		"katex": "~0.18.5",
		"marked": "~18.0.11",
		"mermaid": "~11.17.2"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"cookie": "0.7.2",
		"postcss": {
			"nanoid": "3.3.18"
		},
		"sharp": "0.35.0"
	}
}
