{
	"name": "mdsh",
	"private": true,
	"version": "1.0.0",
	"description": "A local-first WYSIWYG markdown editor - offline, 100% client-side PWA. No server, no account, no telemetry.",
	"license": "MIT",
	"author": "Thomas Crouzet",
	"homepage": "https://thomascrouzet.github.io/mdsh/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ThomasCrouzet/mdsh.git"
	},
	"bugs": {
		"url": "https://github.com/ThomasCrouzet/mdsh/issues"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"pwa",
		"offline",
		"svelte",
		"sveltekit",
		"milkdown",
		"client-side",
		"note-taking"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:pages": "node scripts/preview-pages.mjs",
		"prepare": "svelte-kit sync || true; lefthook install > /dev/null 2>&1 || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"size": "size-limit",
		"analyze": "npx vite-bundle-visualizer",
		"clean": "rm -rf build .svelte-kit node_modules/.vite test-results playwright-report"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "1.61.1",
		"@size-limit/file": "12.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.1.1",
		"@vite-pwa/assets-generator": "1.0.2",
		"@vitest/coverage-v8": "3.2.6",
		"eslint": "^9.20.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.20.0",
		"fake-indexeddb": "^6.0.0",
		"fast-check": "4.9.0",
		"globals": "^17.7.0",
		"jsdom": "^26.0.0",
		"lefthook": "2.1.10",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"size-limit": "12.1.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"svelte-eslint-parser": "^1.6.1",
		"tailwindcss": "^4.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "3.2.6"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.6",
		"@milkdown/crepe": "^7.21.2",
		"@milkdown/kit": "^7.21.2",
		"@types/js-yaml": "4.0.9",
		"@vite-pwa/sveltekit": "1.1.0",
		"dexie": "^4.4.4",
		"dompurify": "~3.4.11",
		"highlight.js": "~11.11.1",
		"js-yaml": "~4.3.0",
		"jszip": "~3.10.1",
		"katex": "~0.17.0",
		"lucide-svelte": "1.0.1",
		"marked": "~18.0.6",
		"mermaid": "~11.16.0"
	}
}
