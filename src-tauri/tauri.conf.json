{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "mdsh",
	"version": "../package.json",
	"identifier": "io.github.thomascrouzet.mdsh",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "mdsh",
				"width": 1280,
				"height": 800,
				"minWidth": 720,
				"minHeight": 480,
				"resizable": true,
				"fullscreen": false,
				"backgroundColor": "#0b0c0d"
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "Local-first offline markdown editor",
		"longDescription": "A local-first WYSIWYG markdown editor. Offline, 100% client-side. No server, no account, no telemetry.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": ["md", "markdown", "mdx"],
				"name": "Markdown",
				"description": "Markdown document",
				"role": "Editor",
				"mimeType": "text/markdown"
			},
			{
				"ext": ["txt"],
				"name": "Plain text",
				"description": "Plain text document",
				"role": "Editor",
				"mimeType": "text/plain"
			}
		]
	},
	"plugins": {}
}
