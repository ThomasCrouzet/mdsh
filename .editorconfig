root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# YAML requires spaces for structural indentation.
# Keep tabs elsewhere to match Prettier (useTabs: true).
# Authors control YAML indentation; do not reformat it automatically.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
